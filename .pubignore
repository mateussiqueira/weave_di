# Negate root .gitignore /packages/ pattern
!pubspec.yaml
!LICENSE
!README.md
!CHANGELOG.md
!lib/
!lib/**/

# Files to EXCLUDE from publishing
.dart_tool/
.packages
pubspec.lock
build/
coverage/
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.test_coverage.dart
test/

